# ===== 源智HR 环境变量配置示例 =====
# 复制本文件为 .env 并修改对应配置

# 服务配置
APP_NAME=源智HR
APP_ENV=dev
APP_PORT=8000
APP_DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# 数据库配置（默认使用SQLite零依赖启动，生产环境请切换MySQL）
DB_TYPE=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=yuanzhi_hr
# SQLite文件路径
SQLITE_PATH=./data/yuanzhi_hr.db

# JWT配置
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 加密密钥（用于API Key加密存储，请务必修改）
ENCRYPT_KEY=please-change-this-encryption-key-to-a-long-random-string

# 跨域配置
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
